{
  "name": "melonpika-profile",
  "version": "1.0.0",
  "private": true,
  "description": "MelonPika's pastel GitHub profile and reproducible SVG generators",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "refresh": "node .github/scripts/generate-profile.mjs",
    "render": "node .github/scripts/generate-profile.mjs --from-snapshot",
    "test": "node --test .github/scripts/profile.test.mjs",
    "validate": "node .github/scripts/validate.mjs",
    "bootstrap": "tsx --tsconfig .github/bootstrap-tsconfig.json .github/scripts/bootstrap-contributions.ts",
    "preview": "node .github/scripts/serve-preview.mjs",
    "preview:check": "node .github/scripts/preview.mjs",
    "check-links": "node .github/scripts/check-links.mjs"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "d3": "^7.9.0",
    "github-markdown-css": "^5.9.0",
    "jsdom": "^26.0.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.56.0",
    "tsx": "^4.20.0",
    "yaml": "^2.8.0"
  }
}
